# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resource_collections

# Auth.js session secret
# Generate with: npm exec auth secret
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# The bootstrap administrator is created on the first sign-in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ZIP storage. Use s3 in production to upload/download directly from the browser.
STORAGE_DRIVER=local

# S3-compatible storage (AWS S3, Cloudflare R2, MinIO, ...)
# STORAGE_DRIVER=s3
# S3_BUCKET=resource-collections
# S3_REGION=auto
# S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Local fallback. Must be an absolute path when set.
# UPLOAD_DIR=F:/data/resource-collections/uploads
MAX_ARCHIVE_SIZE_MB=500
